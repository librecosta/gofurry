# Optional future reverse proxy. Not loaded by the local Compose project.
# Assumes Nginx runs on the same host; TLS and trusted proxies require a later decision.
server {
    listen 127.0.0.1:8090;
    server_name localhost;

    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Request-ID $request_id;
    }
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Request-ID $request_id;
    }
}
