worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stderr crit;

events { worker_connections 1024; }

http {
    include /etc/nginx/mime.types;
    server_tokens off;
    client_header_timeout 10s;
    client_body_timeout 15s;
    proxy_connect_timeout 3s;
    proxy_read_timeout 15s;
    client_body_temp_path /tmp/client;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;
    log_format requests '$request_id $request_method $status $body_bytes_sent $request_time';
    access_log /dev/stdout requests;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:1m;

    upstream ssr {
        zone ssr 64k;
        resolver 127.0.0.11 valid=2s ipv6=off;
        server web:3000 resolve;
        keepalive 8;
    }

    server {
        listen 127.0.0.1:8081;
        access_log off;
        location = /livez { return 204; }
        location = /readyz { proxy_pass http://ssr/readyz; }
        location / { return 404; }
    }

    server {
        listen 8443 ssl default_server;
        http2 on;
        # For a reviewed CN candidate replace with its exact server name.
        server_name 127.0.0.1;
        if ($host != $server_name) { return 421; }
        ssl_certificate /run/edge/site.crt;
        ssl_certificate_key /run/edge/site.key;
        include /etc/nginx/proxy-gofurry.conf;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header X-Content-Type-Options nosniff always;
        client_max_body_size 1m;
        error_page 502 504 =503 @unavailable;

        location = /robots.txt {
            default_type text/plain;
            return 200 "User-agent: *\nDisallow: /\n";
        }
        location = /sitemap.xml { return 404; }
        location = /livez { proxy_pass http://127.0.0.1:8080; }
        location = /readyz { proxy_pass http://127.0.0.1:8080; }
        location = /web-readyz { proxy_pass http://ssr/readyz; }
        location /api/v1/products/ { return 404; }
        location ~* ^/api/v1/sites/[^/]+/interactions(?:/|$) {
            access_log off;
            error_log /dev/null;
            client_max_body_size 1k;
            proxy_pass_request_headers off;
            proxy_set_header Host $host;
            proxy_set_header X-Request-ID $request_id;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header Origin $http_origin;
            proxy_set_header Sec-Fetch-Site $http_sec_fetch_site;
            proxy_set_header Content-Type $http_content_type;
            proxy_set_header Content-Encoding $http_content_encoding;
            proxy_pass http://127.0.0.1:8080;
        }
        location /api/ { proxy_pass http://127.0.0.1:8080; }
        location / { proxy_pass http://ssr; }
        location @unavailable {
            default_type text/plain;
            return 503 "Service unavailable\n";
        }
    }

    server {
        listen 9443 ssl default_server;
        http2 on;
        server_name 127.0.0.1;
        if ($host != $server_name) { return 421; }
        ssl_certificate /run/edge/admin.crt;
        ssl_certificate_key /run/edge/admin.key;
        include /etc/nginx/proxy-gofurry.conf;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header X-Content-Type-Options nosniff always;
        client_max_body_size 64m;
        proxy_read_timeout 125s;
        error_page 502 504 =503 @unavailable;

        location / {
            proxy_request_buffering off;
            proxy_pass http://127.0.0.1:8082;
        }
        location @unavailable {
            default_type text/plain;
            return 503 "Service unavailable\n";
        }
    }
}
